<?xml version="1.0" encoding="utf-8"?>
<!-- Matches android:allowBackup="false": no cloud backup or device transfer
     on Android 12+ (dataExtractionRules). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>
