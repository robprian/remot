# Remot — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The server loads these via `node --env-file=.env src/server.js` (Node 20+).

# GitHub Personal Access Token — used ONLY for pushing to the release repo.
# Scope: repo (or fine-grained with Contents: Read/Write).
GITHUB_PAT=

# Signaling endpoint compiled into the Android app at build time
# (Gradle property -PSIGNALING_URL=… or SIGNALING_URL env / GitHub secret).
# Placeholder only — never put a real endpoint here.
SIGNALING_URL=wss://signal.example.com

# Android release signing (persistent production keystore). These are wired
# into CI via GitHub Secrets; locally they can come from $HOME/.gradle/gradle.properties.
# Placeholders only — never commit a real keystore or password.
RELEASE_KEYSTORE_PATH=/path/to/remot-release.jks
RELEASE_KEYSTORE_PASSWORD=REPLACE_WITH_STORE_PASSWORD
RELEASE_KEY_ALIAS=remot
RELEASE_KEY_PASSWORD=REPLACE_WITH_KEY_PASSWORD
