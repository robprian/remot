# Remot — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The server loads these via `node --env-file=.env src/server.js` (Node 20+).

# GitHub Personal Access Token — used ONLY for pushing to the release repo.
# Scope: repo (or fine-grained with Contents: Read/Write).
GITHUB_PAT=

# Signaling server (the app's release build connects here).
# For local dev the Android debug build defaults to ws://10.0.2.2:8080 (emulator).
SIGNALING_URL=wss://signal.yourdomain.com

# STUN/TURN (coturn). TURN creds are issued to clients by the signaling server;
# the server's TURN_SECRET must equal the coturn static-auth-secret.
STUN_URL=stun:turn.yourdomain.com:3478
TURN_URL=turn:turn.yourdomain.com:3478
TURN_TLS_URL=turns:turn.yourdomain.com:5349
TURN_USERNAME=remot-client
TURN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
